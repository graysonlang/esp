{
  "name": "@graysonlang/esp",
  "version": "2.3.2",
  "description": "A collection of esbuild plugins and utilities.",
  "keywords": [
    "biome",
    "emscripten",
    "esbuild",
    "esbuild-plugin",
    "eslint",
    "glob",
    "lint",
    "plugin",
    "vscode"
  ],
  "homepage": "https://github.com/graysonlang/esp#readme",
  "bugs": {
    "url": "https://github.com/graysonlang/esp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graysonlang/esp.git"
  },
  "license": "MIT",
  "author": "Grayson Lang",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./esbuild-plugin-emcc": {
      "types": "./types/esbuild-plugin-emcc.d.ts",
      "default": "./src/esbuild-plugin-emcc.js"
    },
    "./esbuild-plugin-glob-copy": {
      "types": "./types/esbuild-plugin-glob-copy.d.ts",
      "default": "./src/esbuild-plugin-glob-copy.js"
    },
    "./esbuild-plugin-imp": {
      "types": "./types/esbuild-plugin-imp.d.ts",
      "default": "./src/esbuild-plugin-imp.js"
    },
    "./esbuild-plugin-lint": {
      "types": "./types/esbuild-plugin-lint.d.ts",
      "default": "./src/esbuild-plugin-lint.js"
    },
    "./esbuild-plugin-vscode-problem-matcher": {
      "types": "./types/esbuild-plugin-vscode-problem-matcher.d.ts",
      "default": "./src/esbuild-plugin-vscode-problem-matcher.js"
    },
    "./esbuild-problem-format": {
      "types": "./types/esbuild-problem-format.d.ts",
      "default": "./src/esbuild-problem-format.js"
    },
    "./esbuild-runner": {
      "types": "./types/esbuild-runner.d.ts",
      "default": "./src/esbuild-runner.js"
    },
    "./freshness": {
      "types": "./types/freshness.d.ts",
      "default": "./src/freshness.js"
    },
    "./glglob": {
      "types": "./types/glglob.d.ts",
      "default": "./src/glglob.js"
    },
    "./helpers": {
      "types": "./types/helpers.d.ts",
      "default": "./src/helpers.js"
    },
    "./lint-diagnostics": {
      "types": "./types/lint-diagnostics.d.ts",
      "default": "./src/lint-diagnostics.js"
    },
    "./lint-driver-biome": {
      "types": "./types/lint-driver-biome.d.ts",
      "default": "./src/lint-driver-biome.js"
    },
    "./lint-driver-eslint": {
      "types": "./types/lint-driver-eslint.d.ts",
      "default": "./src/lint-driver-eslint.js"
    },
    "./prepare": {
      "types": "./types/prepare.d.ts",
      "default": "./src/prepare.js"
    }
  },
  "main": "./src/index.js",
  "bin": {
    "esp-generate-dev-cert": "scripts/generate-dev-cert.mjs"
  },
  "directories": {
    "doc": "docs",
    "example": "example"
  },
  "files": [
    "scripts/generate-dev-cert.mjs",
    "src/",
    "types/"
  ],
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "ports": "node ./scripts/build.mjs --print-port",
    "sync:launch": "node ./scripts/build.mjs --sync-launch",
    "build": "node ./scripts/build.mjs --lint --minify",
    "serve": "node ./scripts/build.mjs --lint --sourcemap --watch --serve --debug-port=auto",
    "serve:https": "ESP_DEV_CERT_NAME=$npm_package_config_esp_dev_cert_name npm run serve -- --host=0.0.0.0",
    "dev": "npm run serve -- --proxy --launch",
    "dev:coi": "npm run dev -- --cross-origin-isolation",
    "dev:https": "npm run serve:https -- --proxy --launch",
    "dev:https:coi": "npm run dev:https -- --cross-origin-isolation",
    "vscode:build": "npm run build -- --vscode",
    "vscode:debug": "npm run serve -- --vscode",
    "vscode:debug:https": "npm run serve:https -- --vscode",
    "cert:dev": "ESP_DEV_CERT_NAME=$npm_package_config_esp_dev_cert_name esp-generate-dev-cert",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test test/*.test.mjs",
    "types": "tsc -p tsconfig.types.json",
    "prepack": "npm run types"
  },
  "config": {
    "esp_dev_cert_name": "graysonlang-esp-dev"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./types/index.d.ts"
}
