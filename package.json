{
  "name": "@graysonlang/esp",
  "version": "1.6.1",
  "description": "A collection of esbuild plugins and utilities.",
  "keywords": [
    "emscripten",
    "esbuild",
    "esbuild-plugin",
    "eslint",
    "glob",
    "plugin",
    "vscode"
  ],
  "homepage": "https://github.com/graysonlang/esp#readme",
  "bugs": {
    "url": "https://github.com/graysonlang/esp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graysonlang/esp.git"
  },
  "license": "MIT",
  "author": "Grayson Lang",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./esbuild-plugin-emcc": "./src/esbuild-plugin-emcc.js",
    "./esbuild-plugin-eslint": "./src/esbuild-plugin-eslint.js",
    "./esbuild-plugin-glob-copy": "./src/esbuild-plugin-glob-copy.js",
    "./esbuild-plugin-imp": "./src/esbuild-plugin-imp.js",
    "./esbuild-plugin-vscode-problem-matcher": "./src/esbuild-plugin-vscode-problem-matcher.js",
    "./esbuild-problem-format": "./src/esbuild-problem-format.js",
    "./esbuild-runner": "./src/esbuild-runner.js",
    "./freshness": "./src/freshness.js",
    "./glglob": "./src/glglob.js",
    "./helpers": "./src/helpers.js"
  },
  "main": "./src/index.js",
  "bin": {
    "esp-generate-dev-cert": "scripts/generate-dev-cert.mjs"
  },
  "directories": {
    "doc": "docs",
    "example": "example"
  },
  "files": [
    "scripts/generate-dev-cert.mjs",
    "src/"
  ],
  "scripts": {
    "prepare": "node ./scripts/link-self-bin.mjs",

    "build": "node ./scripts/build.mjs --lint --minify",
    "serve": "node ./scripts/build.mjs --lint --sourcemap --watch --serve --debug-port=9222",
    "serve:https": "ESP_DEV_CERT_NAME=$npm_package_config_esp_dev_cert_name npm run serve -- --host=0.0.0.0 --port=8443",

    "dev": "npm run serve -- --proxy --launch",
    "dev:coi": "npm run dev -- --cross-origin-isolation",
    "dev:https": "npm run serve:https -- --proxy --launch",
    "dev:https:coi": "npm run dev:https -- --cross-origin-isolation",

    "vscode:build": "npm run build -- --vscode",
    "vscode:debug": "npm run serve -- --vscode",
    "vscode:debug:https": "npm run serve:https -- --vscode",

    "cert:dev": "ESP_DEV_CERT_NAME=$npm_package_config_esp_dev_cert_name esp-generate-dev-cert",
    "lint": "eslint . --ignore-pattern 'dist'",

    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "config": {
    "esp_dev_cert_name": "graysonlang-esp-dev"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
